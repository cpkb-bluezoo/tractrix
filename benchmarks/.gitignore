# Fetched parser sources — never vendored, re-fetched by scripts/fetch.sh
vendor/

# Assembled benchmark documents — regenerated by scripts/assemble_corpus.sh
# and scripts/generate_pathological.sh from vendor/. Only corpus_manifest.json
# (checked in) records what went into the pool.
corpus/
corpus_pathological/

# Build output
harness/expat/build/
harness/libxml2/build/
harness/expat/*.o
harness/expat/bench_expat
harness/libxml2/*.o
harness/libxml2/bench_libxml2
harness/quick-xml/target/
harness/tractrix/target/

# Cargo.lock files under harness/ are intentionally committed (bins, not a
# library) so quick-xml's pinned version is reproducible. The root
# .gitignore has a blanket `Cargo.lock` rule (correct for the tractrix
# library crate) that would otherwise shadow these — negate it back.
!harness/quick-xml/Cargo.lock
!harness/tractrix/Cargo.lock

# Python bytecode cache from scripts/report.py
scripts/__pycache__/
