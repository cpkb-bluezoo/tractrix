# Pinned versions of the parsers under comparison. Bump here, then re-run
# scripts/fetch.sh && scripts/build.sh && scripts/assemble_corpus.sh && scripts/run.sh.
#
# fetch.sh resolves each version number to an actual git tag via
# `git ls-remote --tags`, since tag-naming conventions differ per project
# (e.g. expat uses "R_2_8_2", libxml2/quick-xml use "v2.15.3" / plain semver).

EXPAT_REPO="https://github.com/libexpat/libexpat.git"
EXPAT_VERSION="2.8.2"

LIBXML2_REPO="https://gitlab.gnome.org/GNOME/libxml2.git"
LIBXML2_VERSION="2.15.3"

QUICK_XML_REPO="https://github.com/tafia/quick-xml.git"
QUICK_XML_VERSION="0.39.0"

# Referenced directly by expat/tests/xmltest.sh as the suite Expat's own
# tooling tests against — used as Expat's corpus contribution (see
# benchmarks/README.md).
W3C_XMLTEST_URL="https://www.w3.org/XML/Test/xmlts20020606.zip"
